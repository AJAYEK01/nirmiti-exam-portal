generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  password     String
  role         String    @default("STUDENT") // "STUDENT" | "ADMIN"
  schoolName   String?
  className    String?
  rollNumber   String?
  medium       String?   @default("ENGLISH") // "ENGLISH" | "MALAYALAM"
  parentMobile String?
  attempts     Attempt[]
  createdAt    DateTime  @default(now())
}

model Exam {
  id               String     @id @default(uuid())
  title            String
  description      String?
  category         String     @default("General")
  durationMinutes  Int        @default(8)
  totalMarks       Float      @default(25)
  passingMarks     Float      @default(10)
  positiveMarks    Float      @default(1.0)
  negativeMarks    Float      @default(0.0)
  shuffleQuestions Boolean    @default(true)
  isPublished      Boolean    @default(true)
  questions        Question[]
  attempts         Attempt[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Question {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  orderIndex    Int      @default(0)
  text          String
  options       String   // JSON string of string array: ["Option 1", "Option 2", ...]
  correctAnswer Int      // 0-indexed integer
  explanation   String?
  marks         Float?
  negativeMarks Float?
}

model Attempt {
  id                  String         @id @default(uuid())
  examId              String
  userId              String
  startedAt           DateTime       @default(now())
  submittedAt         DateTime?
  timeTakenSeconds    Int?
  selectedQuestionIds String?        // JSON array of question IDs
  optionsOrderMap     String?        // JSON mapping of questionId -> [shuffled index order]
  score               Float          @default(0)
  totalMarks          Float          @default(25)
  isPassed            Boolean        @default(false)
  cheatWarnings       Int            @default(0)
  answers             AnswerRecord[]
  exam                Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnswerRecord {
  id             String   @id @default(uuid())
  attemptId      String
  questionId     String
  selectedOption Int?     // index chosen from candidate's shuffled view
  isMarkedReview Boolean  @default(false)
  isCorrect      Boolean  @default(false)
  marksAwarded   Float    @default(0)
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
